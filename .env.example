# Brainy configuration — copy to .env and adjust. Never commit real secrets.

# Storage
BRAINY_DB_PATH=/data/brainy.db
BRAINY_KNOWLEDGE_ROOT=/data/knowledge
BRAINY_WEB_SESSION_KEY=/data/web_session.key

# Network (localhost by default; public bind only behind a TLS reverse proxy)
BRAINY_BIND_HOST=127.0.0.1
BRAINY_BIND_PORT=8765
BRAINY_ALLOW_PUBLIC=0
BRAINY_RATE_LIMIT=240/60

# Public HTTPS base URL (OAuth issuer for Claude/ChatGPT remote connectors)
BRAINY_PUBLIC_BASE_URL=https://brainy.example.com
BRAINY_OAUTH_PRINCIPAL=claude-account

# Dispatcher guardrails
BRAINY_DISPATCH_MIN_FREE_MB=350
BRAINY_DISPATCH_MAX_CONSEC_FAILS=6

# Worker extensions (comma-separated Python modules exposing workers())
BRAINY_WORKER_PLUGINS=

# Optional: Telegram approvals for proposed knowledge writes (token/secret as 0600 files)
BRAINY_TELEGRAM_TOKEN_FILE=/data/secrets/telegram_token
BRAINY_TELEGRAM_OWNER_CHAT_ID=
BRAINY_TELEGRAM_WEBHOOK_SECRET_FILE=/data/secrets/telegram_webhook_secret
BRAINY_TELEGRAM_APPROVER_PRINCIPAL=bootstrap-admin
