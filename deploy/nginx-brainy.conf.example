# Brainy reverse-proxy vHost. The backend stays localhost-only (127.0.0.1:8765).
# TLS and the HTTP->HTTPS redirect are added by certbot:
#   certbot --nginx -d <hostname> --redirect
server {
    listen 80;
    server_name brainy.example.com;   # <- your hostname

    client_max_body_size 2M;   # conservative
    server_tokens off;
    autoindex off;             # no directory listing

    location / {
        proxy_pass http://127.0.0.1:8765;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }
}
