# Brainy Remote-vHost (Phase F1). Backend bleibt localhost-only (127.0.0.1:8765).
# TLS/HTTP->HTTPS-Redirect werden von certbot ergaenzt:
#   certbot --nginx -d <hostname> --redirect
server {
    listen 80;
    server_name brainy.example.com;   # <- eigenen Hostnamen eintragen

    client_max_body_size 2M;   # konservativ
    server_tokens off;
    autoindex off;             # kein Directory-Listing

    location / {
        proxy_pass http://127.0.0.1:8765;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }
}
